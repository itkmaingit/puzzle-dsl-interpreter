{
  "version": "1.0.0",
  "configurations": [
    {
      "name": "Debug ANTLR4 grammar", // 任意の名前
      "type": "antlr-debug", // 決め打ち(多分)
      "request": "launch", // 決め打ち(多分)
      "grammar": "${file}", // 使用するグラマーファイル
      "input": "/home/node/works/rules/slitherlink.pzl", // 入力となるテキストを記述したファイル
      "printParseTree": true, // デバッグ結果をデバッグコンソールに表示するか
      "visualParseTree": true // デバッグ結果をグラフィカルなツリーで表示するか
    },
    {
      "name": "generator debug",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/puzzle_dsl_interpreter/main.py",
      "args": [
        "--action",
        "generator"
      ],
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "rule debug",
      "type": "debugpy",
      "request": "launch",
      "program": "/home/node/works/data/68a4cff3-588a-4a9a-bce9-88335f95c3f2.py",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
